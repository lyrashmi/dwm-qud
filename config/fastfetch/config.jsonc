{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/vivien/.config/fastfetch/snapjaw.raw",
    "padding": {
      "top": 1,
      "right": 4
    },
    "width": 32,
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": {
      "title": "#ffffff",
      "keys": "#77bfcf",
      "output": "#b1c9c3"
    },
    "key": {
      "width": 11
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "\u25a0",
        "total": "\u00b7"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "#b1c9c3",
        "at": "#98875f",
        "host": "#e99f10"
      }
    },
    {
      "type": "separator",
      "string": "\u25c6\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u25c6",
      "outputColor": "#98875f"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#77bfcf",
      "outputColor": "#b1c9c3"
    },
    {
      "type": "host",
      "key": "HOST",
      "keyColor": "#40a4b9",
      "outputColor": "#b1c9c3",
      "format": "{family}"
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "keyColor": "#0048bd",
      "outputColor": "#b1c9c3"
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      "keyColor": "#cfc041",
      "outputColor": "#b1c9c3"
    },
    {
      "type": "packages",
      "key": "PACKAGES",
      "keyColor": "#00c420",
      "outputColor": "#b1c9c3"
    },
    {
      "type": "shell",
      "key": "SHELL",
      "keyColor": "#b154cf",
      "outputColor": "#b1c9c3"
    },
    {
      "type": "display",
      "key": "DISPLAY",
      "keyColor": "#0096ff",
      "outputColor": "#b1c9c3",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#e99f10",
      "outputColor": "#b1c9c3"
    },
    {
      "type": "terminal",
      "key": "TERMINAL",
      "keyColor": "#f15f22",
      "outputColor": "#b1c9c3"
    },
    "break",
    "break",
    {
      "type": "separator",
      "string": "\u25c7\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u25c7",
      "outputColor": "#98875f"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#d74200",
      "outputColor": "#b1c9c3",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#a64a2e",
      "outputColor": "#b1c9c3",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "keyColor": "#da5bd6",
      "outputColor": "#b1c9c3",
      "percent": {
        "type": 3,
        "green": 55,
        "yellow": 80
      }
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "#98875f",
      "outputColor": "#b1c9c3",
      "percent": {
        "type": 3,
        "green": 55,
        "yellow": 80
      },
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
